# Copy to .env (local) or /etc/wa-logger/env (VPS, chmod 600). Never commit the real file.
PUBLIC_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DISPLAY_TZ=Asia/Kolkata
# Gmail account that sends OTP + alert emails (needs 2-Step Verification + an App Password)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# DATA_DIR=data
# BACKUP_DIR=backups
# LOG_LEVEL=info

# Hosting without config files (e.g. Render): the same JSON as config/admins.json / config/sheets.json.
# ADMINS_JSON=[{"name":"Admin","email":"admin@example.com","phone":"+91 90000 00000","alerts":true}]
# SHEETS_JSON={"targets":[{"key":"indian","groupJid":"1203630000000000@g.us","groupName":"Gladiators Indian Racing 🏇","url":"https://script.google.com/macros/s/<id>/exec"}]}
